NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
JWT_SECRET=abcdefghijklmnopqrstuvwxyz123456
DATABASE_URL=postgresql://mpa:mpa_dev@127.0.0.1:5432/mpa

# Production authentication/session hardening
AUTH_SESSION_DAYS=7

# Optional one-time/controlled bootstrap of the first System Administrator.
# Use local development credentials only in the local environment file.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@localhost.test
BOOTSTRAP_SUPER_ADMIN_PASSWORD=AdminPass12345\!
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.test
BOOTSTRAP_ADMIN_PASSWORD=AdminPass12345\!
BOOTSTRAP_ADMIN_NAME="System Administrator"

# In production, set to the exact HTTPS origin(s) allowed for browser API access.
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Email delivery and notification operations
# Copy to a deployment secret manager for production; never expose secrets as NEXT_PUBLIC_*.
PUBLIC_APP_URL=http://localhost:3001
RESEND_API_KEY=
EMAIL_FROM=MPA Network <verify@example.org>
# Optional alternative provider integration; webhook must be HTTPS and validate the HMAC signature.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
# Optional inbound email provider webhook secret. Send inbound events to /api/v1/email/inbound-webhook
# with X-Email-Webhook-Secret; expose this route only over HTTPS and configure provider validation.
EMAIL_INBOUND_WEBHOOK_SECRET=

# Production auth controls (must stay enabled in production)
EMAIL_VERIFICATION_REQUIRED=true
HUMAN_CHALLENGE_REQUIRED=true
REQUIRE_ADMIN_PASSKEYS=true
# Match the real public admin UI origin and its hostname.
WEBAUTHN_ORIGIN=https://network.example.org
WEBAUTHN_RP_ID=network.example.org
