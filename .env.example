NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://mpa:mpa_dev@localhost:5432/mpa

# Production authentication/session hardening
AUTH_SESSION_DAYS=7

# Optional one-time/controlled bootstrap of the first System Administrator.
# Generate a unique secret (>= 24 characters) and store it only in the server environment.
# Never commit real credentials or place these values in frontend/.env files.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_NAME=System Administrator

# In production, set to the exact HTTPS origin(s) allowed for browser API access.
CORS_ORIGIN=https://www.example.org
